# ============================================================
# Dokter Penjaga — Environment Variables Example
# Emergency-Aware Medical RAG Agent | INaAI 2026
#
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in all values marked with <YOUR_VALUE>
#   3. NEVER commit .env to version control
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Anthropic Claude API key. Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Claude model to use for generation
# Default: claude-sonnet-4-20250514
LLM_MODEL=claude-sonnet-4-20250514

# Max tokens for LLM response
LLM_MAX_TOKENS=1024

# ── Qdrant Vector Database ────────────────────────────────────
# Host where Qdrant is running (Docker default: localhost)
QDRANT_HOST=localhost

# Qdrant HTTP port (default: 6333)
QDRANT_PORT=6333

# Qdrant gRPC port (default: 6334) — leave empty to use HTTP only
QDRANT_GRPC_PORT=6334

# Qdrant collection name for medical documents
QDRANT_COLLECTION=medical_docs

# Optional: Qdrant API key (needed for Qdrant Cloud)
QDRANT_API_KEY=

# ── Embedding Model ────────────────────────────────────────────
# HuggingFace model name for generating embeddings
# Recommended: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# (supports Indonesian + English)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Embedding vector dimension — MUST match the model above
# paraphrase-multilingual-mpnet-base-v2 → 768
EMBEDDING_DIM=768

# ── Hybrid Retrieval Scoring (DATA-03 compliance) ────────────────
# α (alpha): weight for semantic (vector) search score
# Formula: score = α·semantic + (1−α)·BM25 + λ·f(year)
# Range: 0.0–1.0 | Default: 0.6
ALPHA_HYBRID=0.6

# λ (lambda): temporal boost weight
# Range: 0.0–1.0 | Default: 0.1
LAMBDA_TEMPORAL=0.1

# Number of top documents to retrieve per query
TOP_K=5

# ── Temporal Scoring Bounds ──────────────────────────────────────
# Minimum year for normalization in f(year) = (year - YEAR_MIN) / (YEAR_MAX - YEAR_MIN)
YEAR_MIN=2018

# Maximum year (usually current year)
YEAR_MAX=2025

# Year gap threshold to flag temporal conflict between documents
CONFLICT_YEAR_GAP=3

# ── Triage & Emergency ────────────────────────────────────────────
# Path to YAML file containing emergency keyword list (TRIAGE-04 compliance)
TRIAGE_KEYWORD_CONFIG_PATH=config/triage_keywords.yaml

# Emergency hotline number displayed in emergency responses
EMERGENCY_NUMBER=119

# ── Guardrails ────────────────────────────────────────────────────
# Path to YAML file containing guardrail injection patterns
GUARDRAIL_PATTERNS_CONFIG_PATH=config/guardrail_patterns.yaml

# Minimum confidence score for retrieval; below this → warn user (QUALITY-02)
RETRIEVAL_CONFIDENCE_THRESHOLD=0.5

# ── PII Redaction (Microsoft Presidio) ───────────────────────────────
# Primary language for Presidio NER
PRESIDIO_LANGUAGE=id

# spaCy model for NER (used by Presidio)
# xx_ent_wiki_sm = multilingual model (supports Indonesian + English)
# NOTE: id_core_news_lg is NOT available for spaCy 3.8 — do not use
# POST-INSTALL: python -m spacy download xx_ent_wiki_sm
#               python -m spacy download en_core_web_sm
SPACY_MODEL=xx_ent_wiki_sm
SPACY_EN_MODEL=en_core_web_sm

# ── Audit Logger ────────────────────────────────────────────────
# Path to the immutable audit log file (OPS-01 compliance)
AUDIT_LOG_PATH=logs/audit.jsonl

# ── BM25 Index ───────────────────────────────────────────────────
# Path to persist/load the BM25 index artifact
BM25_INDEX_PATH=data/bm25_index.pkl

# ── API Server ────────────────────────────────────────────────────
# Host for the FastAPI server
API_HOST=0.0.0.0

# Port for the FastAPI server
API_PORT=8000

# Enable debug mode (set to false in production)
DEBUG=false

# ── Data Ingestion ────────────────────────────────────────────────
# Directory containing raw document files (PDF/TXT)
DOCUMENTS_DIR=data/documents

# Chunk size in tokens
CHUNK_SIZE=512

# Overlap between consecutive chunks in tokens
CHUNK_OVERLAP=64
